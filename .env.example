# GEMINI_API_KEY: Required for server-side Gemini Vision multi-timeframe chart analysis.
# Supports a single key OR multiple comma-separated keys for automatic pool rotation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOLDAPI_API_KEY: Required for live XAUUSD reference spot price (goldapi.io key OR apify_api_* token).
GOLDAPI_API_KEY="MY_GOLDAPI_API_KEY"

# APIFY_API_TOKEN: Optional separate Apify token for supplementary TradingView Actor hOfycUMuUpaFZvG7a.
APIFY_API_TOKEN="MY_APIFY_API_TOKEN"

# NEWS_API_KEY: Optional economic/news provider key (AskNews ank_*, NewsData.io pub_*, or NewsAPI.org).
NEWS_API_KEY=""

# ADMIN_USERNAME / ADMIN_PASSWORD / ADMIN_SECRET: Admin panel login overrides.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_AUTH_DOMAIN: Optional Firebase authDomain override (defaults to firebase-applet-config.json authDomain).
VITE_FIREBASE_AUTH_DOMAIN=""
